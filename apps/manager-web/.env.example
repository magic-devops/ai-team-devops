# 浏览器入口策略（见 src/lib/shellEntry.ts）
# shell  — 访问站点根时进入 React 管理台（默认，可不写）
# console — 显式回退到完整 legacy console /console.html
# VITE_PRIMARY_UI=shell

# Wujie 微应用远程地址。为空时主应用使用本地原生页面兜底，便于渐进拆分。
# VITE_SUB_APP_AI_FOUNDATION_URL=http://127.0.0.1:5181/
# VITE_SUB_APP_AI_RD_CENTER_URL=http://127.0.0.1:5182/
# VITE_SUB_APP_AI_DATA_CENTER_URL=http://127.0.0.1:5183/
# VITE_SUB_APP_AI_OPS_CENTER_URL=http://127.0.0.1:5184/
