# SQL 数据库 (sqlite | mysql | oceanbase)
# oceanbase：使用 MySQL 协议连接 OceanBase 租户，与 mysql 共用 SQLAlchemy 引擎路径
# 留空或保持旧默认值时，启动脚本会自动使用 ${PROJECT_PATH}/.sop-runtime/db/sop.db
DB_TYPE=sqlite
DATABASE_URL=
# 显式指定示例: DATABASE_URL=sqlite:////absolute/path/.sop-runtime/db/sop.db
# MySQL / OceanBase: DATABASE_URL=mysql+pymysql://sop:sopdev@localhost:2881/sopdb

# 向量数据库 (lance | milvus | qdrant | oceanbase)
# RAG 使用 routers/vector_store_iface.get_store()；管理面克隆等使用 vector_store.get_vector_store()
VECTOR_DB_TYPE=lance
# 留空时默认使用 ${PROJECT_PATH}/.sop-runtime/ai-memory/lancedb
LANCE_DB_PATH=
# Milvus: MILVUS_URI=http://localhost:19530
# Qdrant: QDRANT_URL=http://localhost:6333
# OceanBase/MySQL 存向量(JSON)：可与业务共库；勿与 sqlite 同用
# OCEANBASE_VECTOR_URL=mysql+pymysql://sop:***@obproxy:2883/sop_vec
# OCEANBASE_VECTOR_SCAN_CAP=2500

# 管理模式 (single | saas)
ADMIN_MODE=single

# JWT 密钥（生产环境必须修改）
SECRET_KEY=change-me-in-production
TOKEN_EXPIRE_HOURS=72

# 被管理业务仓库根路径（LanceDB、工作区浏览、规约 memory/ 等）
PROJECT_PATH=.

# 统一运行时根目录（SQLite、日志、ai-memory 物理目录；默认 PROJECT_PATH/.sop-runtime）
# SOP_RUNTIME_DIR=/var/lib/sop-runtime

# 若需完全自定义 AI 数据根（覆盖默认的 ${SOP_RUNTIME_DIR}/ai-memory），取消下行注释：
# AI_MEMORY_ROOT=

# 租户/项目（无 JWT 请求时的 SQL 默认上下文；登录后优先用请求头 X-Project-Id + JWT 解析作用域）
TENANT_ID=t-default
PROJECT_ID=proj-default

# 日志目录（留空则使用 ${SOP_RUNTIME_DIR:-${PROJECT_PATH}/.sop-runtime}/logs）
LOG_DIR=

# 限流 (memory | redis)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_STORAGE=memory
# REDIS_URL=redis://localhost:6379/0

# AI 模型
ANTHROPIC_API_KEY=
KNOWLEDGE_AI_MODEL=claude-3-5-sonnet-20241022
REQUIREMENTS_AI_MODEL=claude-3-5-sonnet-20241022

# 本地 Agent 与 Manager 交互
MANAGER_URL=http://localhost:8765
MANAGER_API_KEY=

# ─────────────────────────── v2 新增配置 ───────────────────────────

# OpenTelemetry：留空则不上报；填写 OTLP gRPC endpoint 即启用
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
# OTEL_SERVICE_NAME=sop-manager
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# SOP_LOG_FORMAT=json
# SOP_LOG_LEVEL=INFO

# HMAC 鉴权强度
# SOP_HMAC_ENFORCE=0     # 1=强制 / 0=日志告警（迁移期）
# SOP_HMAC_WINDOW=300    # ±秒（默认 5 分钟）
# SOP_HMAC_NONCE_TTL=600

# 列加密 / KEK
# SOP_KEK_PROVIDER=env   # env | file | aws-kms
# SOP_MASTER_KEY=<base64url 32 字节>
# SOP_KEK_FILE=/etc/sop/master.key
# SOP_KMS_KEY_ID=<arn:aws:kms:...>
# AWS_REGION=us-east-1
# SOP_ENCRYPT_PII=0      # 1=对 PII 字段自动加密
# SOP_PII_HASH_SALT=<random>

# 审计哈希链 + WORM
# SOP_AUDIT_CHAIN_DIR=
# SOP_AUDIT_WORM=local   # local | s3 | off
# SOP_AUDIT_WORM_DIR=
# SOP_AUDIT_S3_BUCKET=
# SOP_AUDIT_S3_PREFIX=sop-audit/
# SOP_AUDIT_RETAIN_DAYS=365
# SOP_AUDIT_ARCHIVE_INTERVAL=3600

# 工作流引擎
# WORKFLOW_ENGINE=memory # memory | temporal
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_NAMESPACE=default

# 规约 / 技能市场
# SOP_MARKETPLACE_REGISTRIES=https://example.com/index.json,https://internal/index.json
# SOP_MARKETPLACE_DIR=

# 反思蒸馏
# SOP_DISTILL_MIN=3
# SOP_DISTILL_AUTO_APPLY=0.85
# SOP_REFLECTIONS_COLLECTION=rules

# SSO（OIDC / SAML）
# SOP_SSO_PROVIDERS=okta,azure
# SOP_SSO_OKTA_TYPE=oidc
# SOP_SSO_OKTA_ISSUER=https://dev-xxxx.okta.com
# SOP_SSO_OKTA_CLIENT_ID=
# SOP_SSO_OKTA_CLIENT_SECRET=
# SOP_SSO_OKTA_REDIRECT=https://manager.example.com/api/v1/sso/okta/callback
# SOP_SSO_OKTA_SCOPE=openid profile email groups
# SOP_SSO_DOMAIN_TENANT_MAP=acme.com=t-acme,beta.io=t-beta
# SOP_SAML_ENABLED=0

# ABAC（Casbin 或退化版）
# SOP_CASBIN_MODEL=/etc/sop/abac.conf
# SOP_CASBIN_POLICY=/etc/sop/policy.csv
# SOP_ABAC_POLICY=role:admin/*:*
