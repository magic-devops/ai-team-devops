# SQL 数据库 (sqlite | mysql)
# 留空或保持旧默认值时，启动脚本会自动使用 ${PROJECT_PATH}/.sop-runtime/db/sop.db
DB_TYPE=sqlite
DATABASE_URL=
# 显式指定示例: DATABASE_URL=sqlite:////absolute/path/.sop-runtime/db/sop.db
# MySQL: DATABASE_URL=mysql+pymysql://sop:sopdev@localhost:3306/sopdb

# 向量数据库 (lance | milvus)
VECTOR_DB_TYPE=lance
# 留空时默认使用 ${PROJECT_PATH}/.sop-runtime/ai-memory/lancedb
LANCE_DB_PATH=
# Milvus: MILVUS_URI=http://localhost:19530

# 管理模式 (single | saas)
ADMIN_MODE=single

# JWT 密钥（生产环境必须修改）
SECRET_KEY=change-me-in-production
TOKEN_EXPIRE_HOURS=72

# 被管理业务仓库根路径（LanceDB、工作区浏览、规约 memory/ 等）
PROJECT_PATH=.

# 统一运行时根目录（SQLite、日志、ai-memory 物理目录；默认 PROJECT_PATH/.sop-runtime）
# SOP_RUNTIME_DIR=/var/lib/sop-runtime

# 若需完全自定义 AI 数据根（覆盖默认的 ${SOP_RUNTIME_DIR}/ai-memory），取消下行注释：
# AI_MEMORY_ROOT=

# 租户/项目（单项目模式下使用）
TENANT_ID=t-default
PROJECT_ID=proj-default

# 日志目录（留空则使用 ${SOP_RUNTIME_DIR:-${PROJECT_PATH}/.sop-runtime}/logs）
LOG_DIR=

# 限流 (memory | redis)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_STORAGE=memory
# REDIS_URL=redis://localhost:6379/0

# AI 模型
ANTHROPIC_API_KEY=
KNOWLEDGE_AI_MODEL=claude-3-5-sonnet-20241022
REQUIREMENTS_AI_MODEL=claude-3-5-sonnet-20241022

# 本地 Agent 与 Manager 交互
MANAGER_URL=http://localhost:8765
MANAGER_API_KEY=
