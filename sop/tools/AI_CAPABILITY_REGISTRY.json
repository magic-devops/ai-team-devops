{
  "version": "1.0",
  "updated_at": "2026-05-14",
  "control_plane": "sop",
  "capabilities": [
    {
      "id": "context.load",
      "name": "启动上下文加载",
      "events": ["SessionStart", "Startup"],
      "outputs": ["additionalContext", "plain_context"],
      "default_handler": "sop/tools/sop_ai_hook.py"
    },
    {
      "id": "prompt.inspect",
      "name": "提示提交检查",
      "events": ["UserPromptSubmit"],
      "outputs": ["additionalContext", "block"],
      "default_handler": "sop/tools/sop_ai_hook.py"
    },
    {
      "id": "tool.guard",
      "name": "工具执行前守卫",
      "events": ["PreToolUse"],
      "outputs": ["allow", "deny", "ask"],
      "default_handler": "sop/tools/sop_ai_hook.py"
    },
    {
      "id": "permission.decide",
      "name": "权限请求决策",
      "events": ["PermissionRequest"],
      "outputs": ["allow", "deny", "defer"],
      "default_handler": "sop/tools/sop_ai_hook.py"
    },
    {
      "id": "tool.audit",
      "name": "工具执行后审计",
      "events": ["PostToolUse"],
      "outputs": ["activity_log", "quality_signal"],
      "default_handler": "sop/tools/sop_ai_hook.py"
    },
    {
      "id": "state.persist",
      "name": "状态持久化",
      "events": ["Stop", "SessionEnd"],
      "outputs": ["memory/current_state.json", ".ai-memory/activity.log"],
      "default_handler": "sop/tools/sop_ai_hook.py"
    }
  ],
  "adapters": {
    "codex": {
      "entry": "AGENTS.md",
      "config": ".codex/config.toml",
      "hooks": ".codex/hooks.json",
      "hook_policy": ".ai-memory/hook_policy.json",
      "hook_policy_template": "sop/tools/hook_policy.example.json",
      "native_events": ["SessionStart", "UserPromptSubmit", "PreToolUse", "PermissionRequest", "PostToolUse", "Stop"]
    },
    "claude": {
      "entry": "CLAUDE.md",
      "config": ".claude/settings.json",
      "native_events": ["PreToolUse", "PostToolUse", "Stop"]
    },
    "opencode": {
      "entry": "opencode.json",
      "fallback": ["CLI wrapper", "Git hooks", "CI"]
    },
    "cursor": {
      "entry": ".cursorrules",
      "fallback": ["IDE rules", "Git hooks", "CI"]
    }
  }
}
