{
  "_readme": "复制为 .ai-memory/hook_policy.json 后按需修改；缺省则仅使用 sop_ai_hook 内置规则",
  "bash_deny_regex_extra": [
    "\\bgit\\s+push\\s+--force\\b",
    "\\bgit\\s+push\\s+-f\\b",
    "\\bdd\\s+if=\\s*/dev/",
    "\\bmkfs\\.",
    "\\bchmod\\s+\\+?[sx]\\s+/etc\\b"
  ],
  "write_path_deny_substrings": [
    "/.ssh/id_rsa",
    "/.ssh/id_ed25519",
    "/.ssh/id_ecdsa",
    ".aws/credentials",
    ".gnupg/private-keys"
  ],
  "patch_deny_substrings": [
    "+++ b/.ssh/",
    "+++ b/.gnupg/",
    "+++ b/.aws/credentials"
  ],
  "warn_secrets_in_prompt": false,
  "block_secrets_in_prompt": false
}
