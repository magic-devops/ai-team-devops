        "properties": {
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Idempotency Key"
          },
          "expected_version": {
            "anyOf": [
              {
                "type": "integer",
