      "collection": [
        "GET"
      ],
      "entity": [
        "GET"
      ],
      "decision": "POST /approvals/{id}/decision"
    },
    "artifacts": {
      "collection": [
        "GET"
      ],
      "entity": [
        "GET"
      ]
    },
    "sync": {
      "events": "GET /sync?after=0"
    },
    "system": {
      "diagnostics": "GET /system/diagnostics",
      "readiness": "GET /system/readiness",
      "health": "GET /health",
      "actions": "GET /actions"
    }
  },
  "query": [
    "q",
    "status",
    "kind",
    "limit",
    "cursor"
  ],
  "mutation_body": {
    "post": [
      "data",
      "idempotency_key"
    ],
    "patch": [
      "data",
      "idempotency_key",
      "expected_version"
    ],
    "delete": [
      "idempotency_key",
      "expected_version",
      "dry_run"
    ]
  },
  "resource_contracts": {
    "tasks": {
      "title_max_length": 120,
      "title_required": true,
      "statuses": [
        "active",
        "in_progress",
        "blocked",
        "completed",
        "archived"
      ],
      "fields": [
        "title",
        "content",
        "summary",
        "description",
        "priority",
        "assigned_agent",
        "dev_tool",
        "acceptance_criteria",
        "source",
        "kind"
      ]
    },
    "requirements": {
      "title_max_length": 120,
      "title_required": true,
      "statuses": [
        "active",
        "draft",
        "ready",
        "completed",
        "archived"
      ],
      "fields": [
        "title",
        "content",
        "summary",
        "description",
        "priority",
        "assigned_agent",
        "dev_tool",
        "acceptance_criteria",
        "source",
        "kind"
      ]
    },
    "sessions": {
      "title_max_length": 120,
      "title_required": true,
      "statuses": [
        "active",
        "paused",
        "completed",
        "archived"
      ],
      "fields": [
        "title",
        "content",
        "summary",
        "description",
        "assigned_agent",
        "dev_tool",
        "source",
        "kind",
        "workspace_root"
      ]
    },
    "assets": {
      "title_max_length": 120,
      "title_required": true,
      "title_aliases": [
        "name"
      ],
      "statuses": [
        "active",
        "archived"
      ],
      "fields": [
        "title",
        "name",
        "content",
        "summary",
        "description",
        "source",
        "kind"
      ]
    }
  },
  "run_action_body": [
    "idempotency_key",
    "expected_version",
    "dry_run"
  ],
  "approval_decision_body": [
    "decision",
    "idempotency_key",
    "expected_version",
    "dry_run"
  ],
  "task_dispatch_body": [
    "nodes",
    "isolation",
    "base_commit",
    "target_device_id",
    "idempotency_key",
    "expected_version",
    "dry_run"
  ],
  "agent_dispatch_body": [
    "agent_id",
    "squad_id",
    "target_version",
    "prompt",
    "isolation",
    "base_commit",
    "idempotency_key",
    "expected_version",
    "dry_run"
  ],
  "task_review_body": [
    "run_id",
    "run_version",
    "decision",
    "comment",
    "idempotency_key",
    "expected_version",
    "dry_run"
  ],
  "wire": {
    "entity": [
      "id",
      "kind",
      "version",
      "status",
      "data",
      "created_at",
      "updated_at"
