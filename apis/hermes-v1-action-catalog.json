{
  "version": "1.0.0",
  "base_path": "/api/hermes/v1",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "workspace_header": "X-Workspace-Id"
  },
  "envelope": {
    "required": [
      "ok",
      "scope",
      "summary",
      "items",
      "actions",
      "agent_consumption",
      "cli",
      "permissions",
      "audit",
      "trace_id"
    ],
    "items": "array",
    "permissions": "string[]",
    "health_exception": [
      "ok",
      "service",
      "version"
    ]
  },
  "resources": {
    "workspaces": {
      "collection": [
        "GET",
        "POST"
      ],
      "entity": [
        "GET",
        "PATCH"
      ],
      "repository": "GET /workspaces/{id}/repository"
    },
    "sessions": {
      "collection": [
        "GET",
        "POST"
      ],
      "entity": [
        "GET",
        "PATCH"
      ]
    },
    "runs": {
      "collection": [
        "GET",
        "POST"
      ],
      "entity": [
        "GET",
        "PATCH"
      ],
      "events": "GET /runs/{id}/events?after=0",
      "changes": "GET /runs/{id}/changes",
      "actions": [
        "start",
        "cancel",
        "retry",
        "replay",
        "export"
      ]
    },
    "assets": {
      "collection": [
        "GET",
        "POST"
      ],
      "entity": [
        "GET",
        "PATCH",
        "DELETE"
      ],
      "kinds": [
        "memory",
        "knowledge",
        "skill",
        "plugin",
        "data-source"
      ]
    },
    "devices": {
      "collection": [
        "GET",
        "POST"
      ],
      "entity": [
        "GET"
      ],
      "pairing": "POST /devices/{id}/pairing",
      "redeem": "POST /devices/pair",
      "revoke": "POST /devices/{id}/revoke",
      "create_permissions": [
        "config"
      ],
      "pairing_permissions": [
        "config",
        "execute"
      ],
      "revoke_permissions": [
        "config"
      ]
    },
    "agents": {
      "collection": [
        "GET",
        "POST"
      ],
      "entity": [
        "GET",
        "PATCH"
      ],
      "catalog": "GET /agents/catalog",
      "providers": [
        "codex",
        "claude",
        "opencode"
      ],
      "write_permissions": [
        "config"
      ]
    },
    "squads": {
      "collection": [
        "GET",
        "POST"
      ],
      "entity": [
        "GET",
        "PATCH"
      ],
      "routing": "leader-selected members only",
      "write_permissions": [
        "config"
      ]
    },
    "tasks": {
      "collection": [
        "GET",
        "POST"
      ],
      "entity": [
        "GET",
        "PATCH"
      ],
      "delivery": "GET /tasks/{id}/delivery",
      "dispatch": "POST /tasks/{id}/dispatch",
      "agent_dispatch": "POST /tasks/{id}/agent-dispatch",
      "review": "POST /tasks/{id}/review",
      "dispatch_permissions": [
        "write",
        "execute"
      ],
      "agent_dispatch_permissions": [
        "write",
        "execute"
      ],
      "review_permissions": [
        "approve"
      ]
    },
    "requirements": {
      "collection": [
        "GET",
        "POST"
      ],
      "entity": [
        "GET",
        "PATCH"
      ]
    },
    "schedules": {
      "collection": [
        "GET"
      ],
      "entity": [
        "GET"
      ],
      "actions": [
        "preview",
        "configure",
        "trigger",
        "pause",
        "resume",
        "webhook-test"
      ],
      "preview": "POST /schedules/preview",
      "history": "GET /schedules/{id}/history",
      "webhook_test": "POST /schedules/{id}/webhook-test",
      "trigger_kind": [
        "interval",
        "cron",
        "webhook"
      ],
      "configure_body": [
        "title",
        "trigger",
        "nodes",
        "enabled",
        "misfire_coalesce",
        "idempotency_key",
        "expected_version",
        "dry_run"
      ],
      "trigger_body": {
        "interval": [
          "type",
          "interval_seconds",
          "starts_at"
        ],
        "cron": [
          "type",
          "cron_expression",
          "timezone"
        ],
        "webhook": [
          "type",
          "secret_ref",
          "max_body_bytes"
        ]
      },
      "configure_permissions": [
        "config",
        "execute"
      ],
      "preview_permissions": [
        "config",
        "execute"
      ],
      "trigger_permissions": [
        "execute"
      ],
      "pause_permissions": [
        "config"
      ],
      "resume_permissions": [
        "config",
        "execute"
      ],
      "webhook_test_permissions": [
        "execute"
      ]
    },
    "collaboration": {
      "members": "GET /collaboration/members",
      "members_permissions": [
        "read"
      ]
    },
    "remote": {
      "actions": [
        "claim",
        "heartbeat",
        "result"
      ],
      "auth": "workspace-scoped device credential and X-Hermes-Device-Id",
      "supported_nodes": [
        "command"
      ]
    },
